# Copy to .env. Never commit actual secrets.
RAG_APP_NAME=Enterprise RAG Service
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_HUGGINGFACE_TOKEN=
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=
RAG_HUGGINGFACE_CACHE_PATH=data/hf-cache/hub
RAG_VECTOR_STORE_PROVIDER=sqlite
RAG_VECTOR_STORE_PATH=data/rag.sqlite3
RAG_NPC_PROVIDER=local
RAG_HUGGINGFACE_CHAT_MODEL=Qwen/Qwen3-8B
RAG_HUGGINGFACE_INFERENCE_PROVIDER=auto
RAG_HUGGINGFACE_MAX_TOKENS=300
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_WORLD_MODEL_PROVIDER=local
RAG_WORLD_ASSET_PATH=data/worlds
RAG_WORLD_LABS_API_KEY=
RAG_WORLD_LABS_MODEL=marble-1.1
RAG_WORLD_LABS_BASE_URL=https://api.worldlabs.ai
RAG_COSMOS_BASE_URL=http://127.0.0.1:8080
RAG_COSMOS_API_KEY=
